{
  "permissions": {
    "allow": [
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(git clone *)",
      "Bash(rm *)",
      "Bash(docker --version)",
      "Bash(docker compose *)",
      "Bash(cp .env.example .env)",
      "Bash(cp backend/.env.example backend/.env)",
      "Bash(openssl rand *)",
      "Bash(sed -i 's|NEXTAUTH_SECRET=replace_with_a_long_random_string|NEXTAUTH_SECRET=__TRACKED_VAR__|' .env)",
      "Bash(sed -i \"s|NEXTAUTH_URL=https://example.com|NEXTAUTH_URL=http://localhost:3000|\" .env)",
      "Bash(powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | Select-Object -Property LocalAddress,LocalPort,State,OwningProcess | Format-Table -AutoSize\" 2>&1)",
      "Bash(powershell -NoProfile -Command \"Get-Process -Id 37084 | Select-Object -Property Id,ProcessName,Path | Format-List\")",
      "Bash(powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 80 -ErrorAction SilentlyContinue | Select-Object -Property LocalPort,State,OwningProcess | Format-Table -AutoSize\")"
    ]
  }
}
